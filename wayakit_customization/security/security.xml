<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Own category on purpose: a group dropped into the Sales category breaks
         the Sales role dropdown on the user form into loose checkboxes. This one
         implies nothing but Internal User and nothing implies it, so no existing
         role changes; it only shows up as one checkbox for whoever gets it. -->
    <record id="module_category_wayakit_financials" model="ir.module.category">
        <field name="name">Wayakit Financials</field>
        <field name="sequence">60</field>
    </record>

    <record id="group_quotation_financials" model="res.groups">
        <field name="name">Quotation Financials</field>
        <field name="category_id" ref="module_category_wayakit_financials"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Sees cost and margin (from Price Intelligence) on B2B quotations. Confidential.</field>
    </record>
</odoo>
