<odoo>
    <data>
        <record id="delivery_carrier_trendyol_form" model="ir.ui.view">
            <field name="name">delivery.carrier.trendyol.form</field>
            <field name="model">delivery.carrier</field>
            <field name="inherit_id" ref="delivery.view_delivery_carrier_form"/>
            <field name="arch" type="xml">
                <!-- inside the group, not after the delivery_type field: that one lives in
                     a bare <div> and the label would be lost. -->
                <xpath expr="//group[@name='provider_details']" position="inside">
                    <field name="trendyol_provider_code" placeholder="e.g. DHLMP"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
