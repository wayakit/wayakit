<odoo>
    <data noupdate="0">
        <!-- Daily, not on expiry: the 1-month refresh token lapses on a quiet store
             that makes no API call, and then the app has to be reinstalled. -->
        <record id="ir_cron_salla_refresh_tokens" model="ir.cron">
            <field name="name">Salla: Refresh Tokens</field>
            <field name="model_id" ref="model_salla_backend"/>
            <field name="state">code</field>
            <field name="code">model.cron_refresh_tokens()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
        </record>
    </data>
</odoo>
